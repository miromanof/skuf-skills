{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skuf-skills-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "routes": [{ "pattern": "api.skufskills.ru", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://skufskills.ru,https://www.skufskills.ru,https://miromanof.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "skuf-skills-production",
    "database_id": "__D1_DATABASE_ID__",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true }
}
