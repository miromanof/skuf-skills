{
  "name": "skuf-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc -b",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @skuf-skills/api\" \"npm run dev -w @skuf-skills/web\"",
    "infra:up": "docker compose up -d --wait postgres",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "admin:setup": "node scripts/admin-setup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "argon2": "^0.45.1",
    "fastify": "^5.2.0",
    "file-type": "^22.2.0",
    "kysely": "^0.29.7",
    "kysely-pglite": "^0.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
