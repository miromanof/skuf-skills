{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
    ,"baseUrl": ".",
    "paths": {
      "@skuf-skills/domain": ["packages/domain/src/index.ts"]
      ,"@skuf-skills/db": ["packages/db/src/index.ts"]
    }
  }
}
